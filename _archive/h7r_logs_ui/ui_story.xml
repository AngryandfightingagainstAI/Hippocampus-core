id.view.ViewGroup" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,228][1080,2238]"><node index="5" text="“醒了？”他开口，声音不高，带着本地口音，“这地方不让睡。你是外地来的？”" resource-id="" class="android.widget.TextView" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,228][1032,35]" /><node index="6" text="[2026-09-30 11:18]" resource-id="" class="android.widget.TextView" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,228][1032,92]" /><node index="7" text="（（跟进手机信息）【手机】未知号码：老王又发来一条：锅炉房后墙的砖松了，你上次落下的那包东西我塞在里面。别白天来，晚上八点后。）" resource-id="" class="android.widget.TextView" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,228][1032,311]" /><node index="8" text="第 2 轮 · 2000-10-20 08:04" resource-id="" class="android.widget.TextView" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,329][1032,371]" /><node index="9" text="口袋里的诺基亚震了一下，短促的一声。你摸出来，屏幕的绿光在晨色里发暗，是同一个号码。第二行字挤在窄小的屏幕上：**锅炉房后墙的砖松了，你上次落下的那包东西我塞在里面。别白天来，晚上八点后。**" resource-id="" class="android.widget.TextView" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,389][1032,681]" /><node index="10" text="老王看着你掏手机的动作，没凑近，只是把手从兜里抽出来，往巷口那边偏了偏头。早点摊的方向传来一声吆喝，混着自行车铃。" resource-id="" class="android.widget.TextView" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,693][1032,912]" /><node index="11" text="“看完了？”他问，语气还是那样不咸不淡，“东西我给你收着了，你自己去取。砖从下往上数第三块，别记岔了。”他顿了顿，把塑料袋口往上拎了拎，“油条不要就算了，我拿去给老陈家的丫头。”" resource-id="" class="android.widget.TextView" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,924][1032,1216]" /><node index="12" text="说完他转身要走，脚步不快，像是给你留了开口的余地。" resource-id="" class="android.widget.TextView" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1228][1032,1374]" /><node index="13" text="[2026-09-30 11:18]" resource-id="" class="android.widget.TextView" package="com.hippocampusrn" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1389][1032,1431]" /><node index="14" text="" resource-id="" class="android.view.ViewGroup" package="com.hippocampusrn" content-desc="(1 叫住他，问锅炉房在哪个位置。" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1473][1032,1585]"><node index="0" text="(1 叫住他，问锅炉房在哪个位置。" resource-id="" class=